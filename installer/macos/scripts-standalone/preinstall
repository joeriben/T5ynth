#!/bin/bash
# Remove previous akroasys.app before installing new version.
# Prevents stale files from manual installs corrupting the bundle signature.
# T5ynth 2.5.3 (the pre-rename product) is a separate, still-supported app and must NOT be touched here.

TARGET_VOLUME="${2:-/}"

target_path() {
    local path="$1"
    if [[ "$TARGET_VOLUME" == "/" ]]; then
        printf '%s\n' "$path"
    else
        printf '%s%s\n' "$TARGET_VOLUME" "$path"
    fi
}

rm -rf "$(target_path "/Applications/akroasys.app")"
exit 0
