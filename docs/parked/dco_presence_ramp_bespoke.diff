+    // ── Dual A+B DCO presence crossfade (docs: dual_osc_build_spec.md) ──
+    // When a new DCO recipe flips WHICH oscillators are audible
+    // (dcoOscAHasContent / dcoOscBHasContent) WHILE a note is held, the per-
+    // oscillator mix gains crossfade over the Regen XFade time
+    // (BlockParams::driftCrossfade) instead of hard-cutting whichever engine
+    // just lost its flag. The held-note invariant applies to "which engine is
+    // audible" exactly as it does to buffer content — which the oscillators
+    // already morph — so this uses the SAME cos/sin equal-power law
+    // (WavetableOscillator's buffer morph) on the gain numbers. In steady state
+    // (no flag change) presRampT_ stays >= 1 and the gains track the live
+    // oscMix / dcoGain every sample, so the manual H/I slider still responds
+    // instantly and any session that never touches DCO is unaffected (its flags
+    // never flip, so a ramp is never armed and the mix stays A-solo unity).
+    float presGainA_ = 0.0f;        // current emitted A gain (multiplies aSample)
+    float presGainB_ = 0.0f;        // current emitted B gain (multiplies bSample)
+    float presGainAStart_ = 0.0f;   // A gain captured at ramp start
+    float presGainBStart_ = 0.0f;   // B gain captured at ramp start
+    float presRampT_ = 1.0f;        // ramp position 0..1; >= 1 == idle (snap to target)
+    float presRampInc_ = 0.0f;      // per-sample step = 1 / driftCrossfade-samples
+    bool  presAAudible_ = false;    // last block's A-audible state (flip detection)
+    bool  presBAudible_ = false;    // last block's B-audible state (flip detection)
+    bool  presInit_ = false;        // false until first render after noteOn (snap, no ramp)
+    // Crossfade law for the CURRENT ramp, chosen at arm time by whether the old
+    // and new audible SETS are disjoint. cos/sin equal-power is power-preserving
+    // ONLY for uncorrelated signals; the start/target mixes share the SAME live
+    // aSample/bSample, so cos/sin on the gain vector overshoots (>unity) on any
+    // transition where an oscillator is audible in BOTH states (A-solo<->dual,
+    // dual<->solo). A disjoint handoff (A-solo<->B-solo, silence<->solo) has no
+    // shared oscillator — there cos/sin is exactly the buffer-morph equal-power
+    // law and provably does NOT overshoot. Shared-oscillator transitions use a
+    // monotonic linear gain ramp (never exceeds max(start,target), so nothing is
+    // driven above unity into the drive/filter), which is still click-free.
+    bool  presRampEqualPower_ = false;
